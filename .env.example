# --- Docker / VM (PROCEIT) ---
APP_NAME=auth
APP_DOMAIN=auth-dev.proceit.net
APP_VERSION=latest
APP_PORT=3000
APP_MEMORY_LIMIT=512m

# --- Aplicação ---
# Banco no PostgreSQL compartilhado da VM (rede "db"): host "postgres"
DATABASE_URL=postgresql://<usuario>:<senha>@postgres:5432/<banco>
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_COOKIE_NAME=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_SECURE=
AUTH_REFRESH_COOKIE_NAME=
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAME_SITE=
AUTH_REFRESH_COOKIE_SECURE=
AUTH_SESSION_MAX_AGE_SECONDS=
AUTH_REFRESH_MAX_AGE_SECONDS=
AUTH_BCRYPT_ROUNDS=
